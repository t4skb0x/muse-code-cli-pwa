[Unit]
Description=Cloudflare Tunnel connector for the Muse Code CLI PWA
After=network-online.target muse-pwa.service
Wants=network-online.target

[Service]
# Uses a remotely-managed tunnel token. Create it once in the Cloudflare
# dashboard (Zero Trust → Networks → Tunnels) and save it to the path below.
ExecStart=%h/.local/bin/cloudflared tunnel run --token-file %h/.cloudflared/muse-pwa.token
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
