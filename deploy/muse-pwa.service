[Unit]
Description=Muse Code CLI PWA origin server (phone remote: chat/files/terminal/tasks)
After=network.target

[Service]
# Adjust APP_DIR to wherever you cloned this repo.
Environment=APP_DIR=%h/muse-code-cli-pwa
ExecStart=/usr/bin/python3 ${APP_DIR}/server.py
WorkingDirectory=${APP_DIR}
# Optional: scope the Files tab and task repos to a project folder instead
# of your whole home directory:
# Environment=MUSE_PWA_WORKSPACE=%h/projects
# Optional: bind a different port:
# Environment=MUSE_PWA_PORT=3091
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
