[Unit]
Description=Muse Code CLI PWA task worker (headless muse exec for phone tasks)
After=muse-pwa.service

[Service]
# Adjust to wherever you cloned this repo. Keep MUSE_PWA_WORKSPACE in sync
# with muse-pwa.service if you overrode it there.
ExecStart=/usr/bin/python3 ${APP_DIR}/worker.py
WorkingDirectory=${APP_DIR}
# Environment=MUSE_PWA_WORKSPACE=%h/projects
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
